<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.mshz.cloud.tms.business.mapper.TMetaModelShowStyleMapper">

    <insert id="insertTMetaModelShowStyleList">
        <foreach collection="list" item="item" index="index" separator=";">
            insert into t_meta_model_show_style
            <trim prefix="(" suffix=")" suffixOverrides=",">
                <if test="item.id != null">id,</if>
                <if test="item.modelId != null">model_id,</if>
                <if test="item.columnId != null">column_id,</if>
                <if test="item.modelVersion != null">model_version,</if>
                <if test="item.value != null">value,</if>
                <if test="item.style != null">style,</if>
            </trim>
            <trim prefix="values (" suffix=")" suffixOverrides=",">
                <if test="item.id != null">#{item.id},</if>
                <if test="item.modelId != null">#{item.modelId},</if>
                <if test="item.columnId != null">#{item.columnId},</if>
                <if test="item.modelVersion != null">#{item.modelVersion},</if>
                <if test="item.value != null">#{item.value},</if>
                <if test="item.style != null">#{item.style},</if>
            </trim>
        </foreach>
    </insert>

    <delete id="deleteTMetaModelShowStyleByModelId">
        delete from t_meta_model_show_style where model_id = #{modelId} and column_id = #{columnId}
    </delete>
</mapper>
