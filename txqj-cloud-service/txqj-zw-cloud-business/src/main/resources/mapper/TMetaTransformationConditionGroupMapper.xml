<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.mshz.cloud.tms.business.mapper.TMetaTransformationConditionGroupMapper">

    <resultMap type="TMetaTransformationConditionGroup" id="TMetaTransformationConditionGroupResult">
        <result property="id"    column="id"    />
        <result property="metaModelId"    column="meta_model_id"    />
        <result property="metaModelVersion"    column="meta_model_version"    />
        <result property="conditionGroupName"    column="condition_group_name"    />
        <result property="createBy"    column="create_by"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateBy"    column="update_by"    />
        <result property="updateTime"    column="update_time"    />
        <result property="remark"    column="remark"    />
    </resultMap>

    <sql id="selectTMetaTransformationConditionGroupVo">
        select id, meta_model_id, meta_model_version, condition_group_name, create_by, create_time, update_by, update_time, remark from t_meta_transformation_condition_group
    </sql>

    <select id="selectTMetaTransformationConditionGroupList" parameterType="TMetaTransformationConditionGroup" resultMap="TMetaTransformationConditionGroupResult">
        <include refid="selectTMetaTransformationConditionGroupVo"/>
        <where>
            <if test="metaModelId != null "> and meta_model_id = #{metaModelId}</if>
            <if test="metaModelVersion != null  and metaModelVersion != ''"> and meta_model_version = #{metaModelVersion}</if>
            <if test="conditionGroupName != null  and conditionGroupName != ''"> and condition_group_name like concat('%', #{conditionGroupName}, '%')</if>
        </where>
    </select>

    <select id="selectTMetaTransformationConditionGroupById" parameterType="Long" resultMap="TMetaTransformationConditionGroupResult">
        <include refid="selectTMetaTransformationConditionGroupVo"/>
        where id = #{id}
    </select>

    <insert id="insertTMetaTransformationConditionGroup" parameterType="TMetaTransformationConditionGroup" useGeneratedKeys="true" keyProperty="id">
        insert into t_meta_transformation_condition_group
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="metaModelId != null">meta_model_id,</if>
            <if test="metaModelVersion != null">meta_model_version,</if>
            <if test="conditionGroupName != null">condition_group_name,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateBy != null">update_by,</if>
            <if test="updateTime != null">update_time,</if>
            <if test="remark != null">remark,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="metaModelId != null">#{metaModelId},</if>
            <if test="metaModelVersion != null">#{metaModelVersion},</if>
            <if test="conditionGroupName != null">#{conditionGroupName},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateBy != null">#{updateBy},</if>
            <if test="updateTime != null">#{updateTime},</if>
            <if test="remark != null">#{remark},</if>
         </trim>
    </insert>

    <update id="updateTMetaTransformationConditionGroup" parameterType="TMetaTransformationConditionGroup">
        update t_meta_transformation_condition_group
        <trim prefix="SET" suffixOverrides=",">
            <if test="metaModelId != null">meta_model_id = #{metaModelId},</if>
            <if test="metaModelVersion != null">meta_model_version = #{metaModelVersion},</if>
            <if test="conditionGroupName != null">condition_group_name = #{conditionGroupName},</if>
            <if test="createBy != null">create_by = #{createBy},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="remark != null">remark = #{remark},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteTMetaTransformationConditionGroupById" parameterType="Long">
        delete from t_meta_transformation_condition_group where id = #{id}
    </delete>

    <delete id="deleteTMetaTransformationConditionGroupByIds" parameterType="String">
        delete from t_meta_transformation_condition_group where id in
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
</mapper>
