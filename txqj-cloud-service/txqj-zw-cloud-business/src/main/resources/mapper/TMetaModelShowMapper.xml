    </sql>

    <sql id="selectMetaModelShowVo">
      select t.column_name,t.column_name_cn,t.column_type, t.column_length,
             s.id, t.model_id, t.id as column_id, s.is_query, s.is_visible, s.sort_num,
             t.model_version, s.create_date, s.update_date, s.is_advanced_query_index,
             s.is_custom_query, s.advanced_query_order, s.is_advanced_query,s.sortable,
             s.is_jump_link, s.menu_id, s.menu_path, s.link_re_meta_model_id, s.link_re_meta_model,
             s.link_re_meta_model_cn, s.link_re_column_id, s.link_re_column_name, s.link_re_column_name_cn,
             s.is_merge_rows, s.relate_search_condition, s.relate_search_attribute_id, s.relate_search_attribute, s.relate_search_name,
             s.icon,s.is_style,ss.id AS style_id,ss.value,ss.style
      from t_meta_model_tech t
      left join t_meta_model_show s on s.model_id = t.model_id and s.model_version = t.model_version and s.column_id = t.id
      LEFT JOIN t_meta_model_show_style ss ON s.model_id = s.model_id AND ss.model_version = ss.model_version AND s.column_id = ss.column_id
    </sql>

    <select id="selectMetaDataSyncVoList" parameterType="com.mshz.cloud.tms.business.vo.MetaModelShowVo"
            resultMap="MetaDataSyncResult">
        select
        cf.db_username,t.table_name,r.relation_table_alias,r.is_external_connection,co.column_name,co.column_type,v.model_version_alias,te.column_name
        as target_column_name,
        te.column_type as target_column_type ,
        r.relation_condition,r.relation_type,r.sql_content,r.model_id,r.model_version,te.is_primary_key,te.update_or_not
        from t_meta_model_relation r
        left join t_db_config cf on r.relation_db_id = cf.id
        left join t_db_table t on r.relation_table_id = t.id
        left join t_db_table_column co on r.relation_column_id = co.id
        left join t_meta_model_tech te on r.model_id = te.model_id and r.model_version= te.model_version
        and r.column_id = te.id
        left join t_meta_model_version v on r.model_id = v.model_id and r.model_version=v.model_version
        where r.model_id=#{modelId} and r.model_version=#{modelVersion} and( (r.relation_type=1 and r.relation_column_id
        is not null) or r.relation_type=2)
        <if test="updateOrNot!=null">
            and te.update_or_not = #{updateOrNot}
        </if>
        <if test="isCustomQuery!=null">
            and r.sql_content is not null and r.sql_content != ''
        </if>
        order by r.relation_type desc,r.sql_content desc
    </select>

