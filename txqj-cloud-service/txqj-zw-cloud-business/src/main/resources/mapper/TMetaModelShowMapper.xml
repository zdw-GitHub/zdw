        NULL is_external_connection,
        trim(te.column_name) AS column_name,
        te.column_type AS column_type,
        v.model_version_alias,
        trim(te.column_name) AS target_column_name,
        te.column_type AS target_column_type,
        NULL relation_condition,
        NULL relation_type,
        NULL sql_content,
        te.model_id,
        te.model_version,
        te.is_primary_key,
        te.update_or_not
        FROM
        t_meta_model_tech te
        LEFT JOIN t_meta_model mo ON mo.id = te.model_id
        LEFT JOIN t_meta_model_version v ON te.model_id = v.model_id
        AND te.model_version COLLATE utf8mb4_unicode_ci = v.model_version
        WHERE te.model_id = #{modelId}
        AND te.model_version = #{modelVersion}
        <if test="updateOrNot!=null">
            and te.update_or_not = #{updateOrNot}
        </if>
    </select>

